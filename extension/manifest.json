{
  "manifest_version": 3,
  "name": "Trackly",
  "version": "1.0",
  "permissions": ["storage"],
  "host_permissions": ["http://127.0.0.1:8000/*"],
  "action": {
    "default_popup": "./UI/popup.html"
  },
  "content_scripts": [
    {
      "matches": ["*://*.netflix.com/*"],
      "js": ["content.js"]
    }
  ]
}