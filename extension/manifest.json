{
  "manifest_version": 3,
  "name": "Trackly",
  "version": "1.0",
  "permissions": ["activeTab","storage"],
  "host_permissions": ["http://127.0.0.1:8000/*"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "./UI/popup.html"
  },
  "content_scripts": [
    {
      "matches": [
                  "*://*.netflix.com/*",
                  "*://*.spotify.com/*",
                  "*://*.youtube.com/*",
                  "*://*.disneyplus.com/*",
                  "*://*.hbomax.com/*",
                  "*://*.max.com/*",
                  "*://*.apple.com/*",
                  "*://*.icloud.com/*",
                  "*://*.adobe.com/*",
                  "*://*.microsoft.com/*",
                  "*://*.github.com/*"
                ],
      "js": [
        "shared/storage.js",
        "shared/detector.js",
        "shared/journey-state.js",
        "shared/dedupe-state.js",
        "shared/detection-toast.js",
        "content.js"
      ]
    }
  ]
}