{
  "name": "trackly-mobile",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start --go",
    "ios": "expo start --go --ios",
    "android": "expo start --go --android",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "build": "expo export --platform all"
  },
  "dependencies": {
    "@expo-google-fonts/manrope": "0.4.2",
    "@expo-google-fonts/source-sans-3": "0.4.1",
    "@expo/vector-icons": "15.0.3",
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "57.0.26",
    "expo-constants": "57.0.20",
    "expo-font": "57.0.4",
    "expo-linking": "57.0.11",
    "expo-localization": "57.0.2",
    "expo-router": "57.0.24",
    "expo-splash-screen": "57.0.9",
    "expo-status-bar": "57.0.1",
    "expo-system-ui": "57.0.4",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "5.7.0",
    "react-native-screens": "4.26.2",
    "react-native-web": "0.21.3"
  },
  "devDependencies": {
    "@types/node": "24.0.0",
    "@types/react": "19.2.18",
    "eslint": "9.39.5",
    "eslint-config-expo": "57.0.2",
    "typescript": "6.0.3"
  },
  "overrides": {
    "postcss": "8.5.29"
  },
  "engines": {
    "node": ">=22.13.0"
  }
}
